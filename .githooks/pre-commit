#!/bin/sh
# Reject commits whose Rust code is not rustfmt-clean.
#
# Why: recurring "formatter noise" incidents where an edit lands unformatted
# (often from rustfmt version skew between sessions/agents). Byte-level noise
# then stales downstream workspace claims for no semantic reason. Catch it at
# the commit boundary instead of by hand each session.
#
# Scope note: this checks the whole working tree, not just the staged index.
# For this agent-driven repo commits are typically whole-tree, so "tree must be
# clean" is the behavior we want. If you ever need to commit with unrelated
# unformatted changes in flight, run `cargo fmt` first or `git commit --no-verify`.
if ! cargo fmt --check >/dev/null 2>&1; then
	echo "pre-commit: rustfmt check failed — run 'cargo fmt' and re-stage." >&2
	cargo fmt --check 2>&1 | sed 's/^/  /' >&2
	exit 1
fi

# Reject commits whose Pi extension TypeScript is not Biome-clean.
#
# Same rationale as the Rust gate above, one layer over: an edit-time formatter
# (or a session running a different formatter) can otherwise land byte-noise in
# the .ts adapter that stales downstream workspace claims for no semantic reason.
# Canonical is defined by .pi/extensions/agent-workspace/biome.json and the
# Biome version is pinned via that package's lockfile, so every environment
# produces identical output. Biome discovers its config from the working
# directory, so the check runs with that directory as cwd (mirrors how the npm
# `format:check` script is invoked). Directory-form check, so a brand-new .ts
# file is covered the moment it exists — no module-wiring blind spot.
#
# If the pinned Biome is absent (a clone that has not run `npm ci` in the
# extension), skip with a note rather than block unrelated commits — the same
# pragmatic stance the Rust gate takes toward a missing toolchain.
ext_dir=.pi/extensions/agent-workspace
biome_bin="$ext_dir/node_modules/.bin/biome"
if [ -x "$biome_bin" ]; then
	if ! ( cd "$ext_dir" && ./node_modules/.bin/biome format . >/dev/null 2>&1 ); then
		echo "pre-commit: Biome check failed — run 'npm run format' in $ext_dir and re-stage." >&2
		( cd "$ext_dir" && ./node_modules/.bin/biome format . 2>&1 | sed 's/^/  /' >&2 )
		exit 1
	fi
else
	echo "pre-commit: note — pinned Biome not found; skipping TS format gate (run 'npm ci' in $ext_dir to enable)." >&2
fi
